{
  "name": "asanwa-boutique",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/game/convos.test.ts src/game/business.test.ts src/game/shop-relocation.test.ts src/game/shopper.test.ts src/game/politician-contracts.test.ts src/game/market-catalog.test.ts src/game/customers.test.ts src/game/power.test.ts src/game/market-cart.test.ts src/game/staff-and-racks.test.ts src/game/rivals-balance.test.ts src/game/climate.test.ts src/game/shop-climate.test.ts src/game/expert-staff.test.ts src/game/staff-poaching.test.ts src/game/orders.test.ts src/game/wall-placement.test.ts src/game/sales.test.ts src/game/giveaway.test.ts src/game/owambe.test.ts src/game/staff-posts.test.ts",
    "server": "tsx server.ts",
    "start": "npm run build && tsx server.ts",
    "check:locale-safe": "node tools/check-locale-safe.mjs",
    "desktop:run": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-three/drei": "10.0.6",
    "@react-three/fiber": "9.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^11.10.0",
    "lucide-react": "^0.546.0",
    "lz-string": "^1.5.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "0.170.0",
    "vite": "^8.3.0",
    "@capacitor/core": "8.5.2",
    "@capacitor/android": "8.5.2",
    "@capacitor-firebase/authentication": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/haptics": "8.0.2",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/playfair-display": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.170.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "firebase-tools": "^14.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@capacitor/cli": "8.5.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.corur131.asanwaboutique",
    "productName": "Asanwa Boutique",
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "assets/icon-only.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "Asanwa-Boutique-Windows-${version}-${arch}.${ext}"
  }
}
