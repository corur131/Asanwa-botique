# Server-only Gemini API credentials. Never use a VITE_ prefix for this key.
# Create a key in Google AI Studio and set it in the server environment.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional. Default is the current stable Flash model.
GEMINI_MODEL="gemini-3.8-flash"

# Local API server port.
PORT=8787

# Used by the AI Studio/Cloud Run environment when it provides a public URL.
APP_URL="http://localhost:8787"
